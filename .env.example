# Copy this file to .env.local and fill in every value. SETUP.md explains each one.

# The only Google account allowed to sign in
ALLOWED_EMAIL=you@gmail.com

# Auth.js session secret:  openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Key that encrypts stored Google tokens:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Postgres connection string (Neon "pooled" connection string)
DATABASE_URL=
